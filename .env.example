# Copia este archivo como .env y sustituye el valor de SECRET_KEY.
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
FLASK_DEBUG=1
PORT=5000

# PostgreSQL local publicado por Docker Compose en el puerto 5433.
POSTGRES_USER=descubre
POSTGRES_PASSWORD=CAMBIAR_ANTES_DE_USAR_123
POSTGRES_DB=descubre_oaxaca
DB_PORT=5433
DATABASE_URL=postgresql+psycopg://descubre:CAMBIAR_ANTES_DE_USAR_123@localhost:5433/descubre_oaxaca

# Para Flask ejecutado directamente en Windows.
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma4:e4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
