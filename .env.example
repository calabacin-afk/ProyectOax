# Copia este archivo como .env y sustituye el valor de SECRET_KEY.
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
PORT=5000
BIND_ADDRESS=127.0.0.1
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://

# Chroma persistente (sin servidor HTTP separado en el MVP).
# Al ejecutar Flask directamente, los datos se guardan en esta carpeta.
CHROMA_PATH=./chroma_data
CHROMA_CATALOG_COLLECTION=lugares_catalogo_v1
CHROMA_COLLECTION=lugares_qwen3_embedding_0_6b_v1

# Para Flask ejecutado directamente en Windows.
OLLAMA_URL=http://localhost:11434
OLLAMA_URL_DOCKER=http://host.docker.internal:11434
GEMMA_MODEL=gemma4:e2b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024
OLLAMA_TIMEOUT_SECONDS=45
